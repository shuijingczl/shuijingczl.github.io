---
layout: default
---
<div class="post">
  <header class="post-header" style="margin-bottom: 1.5rem;">
    <h1 class="post-title" style="font-size: 2.3rem; font-weight: 700; letter-spacing: -0.5px;">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc" style="font-size: 1.08rem; color: #57606a; margin-top: 4px;">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}" style="margin-bottom: 1.5rem;">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          <div class="profile-avatar-wrapper">
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid profile-img-academic" sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="profile-info-block">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix academic-content">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 style="margin-top: 2.5rem; font-weight: 600;">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit;">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2 style="margin-top: 2.5rem; font-weight: 600;">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit;">Recent Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 style="margin-top: 2.5rem; font-weight: 600;">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit;">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

<style>
.profile-avatar-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 0.85rem;
}
.profile-img-academic {
  max-width: 220px !important;
  width: 100% !important;
  height: auto !important;
  border-radius: 4px !important;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12) !important;
  border: 1px solid #d0d7de !important;
}
.profile-info-block {
  font-family: "Times New Roman", Times, serif !important;
  font-size: 0.94rem;
  line-height: 1.6;
  color: #333333;
  margin-top: 0.5rem;
}
.dark-mode .profile-info-block {
  color: #c9d1d9;
}
.profile-info-block p {
  display: block !important;
  margin-bottom: 0.35rem !important;
}
.profile-info-block p:last-child {
  margin-bottom: 0 !important;
}
.academic-content {
  font-family: "Times New Roman", Times, serif !important;
  font-size: 1.05rem;
  line-height: 1.75;
  color: #24292f;
}
.dark-mode .academic-content {
  color: #c9d1d9;
}
.academic-content h2 {
  font-family: "Times New Roman", Times, serif !important;
  font-size: 1.45rem;
  font-weight: 700;
  margin-top: 2rem;
  margin-bottom: 0.85rem;
  padding-bottom: 0.35rem;
  border-bottom: 1px solid #d0d7de;
}
.dark-mode .academic-content h2 {
  border-color: #30363d;
  color: #f0f6fc;
}
.academic-content h3 {
  font-family: "Times New Roman", Times, serif !important;
  font-size: 1.15rem;
  font-weight: 700;
  margin-top: 1.25rem;
  margin-bottom: 0.5rem;
}
.dark-mode .academic-content h3 {
  color: #e6edf3;
}
.academic-content ul {
  padding-left: 1.3rem;
  margin-bottom: 1.1rem;
}
.academic-content li {
  margin-bottom: 0.5rem;
}
.academic-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid #e1e4e8;
}
.dark-mode .academic-links {
  border-color: #30363d;
}
.academic-link-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: "Times New Roman", Times, serif !important;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.2rem 0.55rem;
  border-radius: 3px;
  background: #f6f8fa;
  border: 1px solid #d0d7de;
  color: #24292f !important;
  text-decoration: none !important;
  transition: all 0.15s ease;
}
.academic-link-btn:hover {
  background: #0969da;
  color: #ffffff !important;
  border-color: #0969da;
}
.dark-mode .academic-link-btn {
  background: #21262d;
  border-color: #30363d;
  color: #c9d1d9 !important;
}
.dark-mode .academic-link-btn:hover {
  background: #1f6feb;
  color: #ffffff !important;
  border-color: #1f6feb;
}
.edu-block {
  margin-bottom: 1.2rem;
}
.edu-degree {
  font-weight: 700;
  font-size: 1.05rem;
  color: #1f2328;
}
.dark-mode .edu-degree {
  color: #f0f6fc;
}
.edu-inst {
  font-style: italic;
  color: #475569;
  font-size: 0.98rem;
}
.dark-mode .edu-inst {
  color: #8b949e;
}
.edu-detail {
  font-size: 0.92rem;
  color: #57606a;
  margin-top: 0.15rem;
}
.dark-mode .edu-detail {
  color: #8b949e;
}
</style>
